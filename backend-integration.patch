+// Start the backend:  npm start   (reads backend/.env)
+import { loadEnv } from "./src/env.js";
+loadEnv(new URL("./.env", import.meta.url));
+
+const { createApp, demoNowFromEnv } = await import("./src/app.js");
+const { validateCampus } = await import("./src/planner.js");
+
+const PORT = Number(process.env.PORT || 8787);
+const demo = demoNowFromEnv();
+const v = validateCampus();
+
+createApp().listen(PORT, () => {
+  console.log(`Campus Survival API  ->  http://localhost:${PORT}/api/health`);
+  console.log(`  Gemini:    ${process.env.GEMINI_API_KEY ? `on (${process.env.GEMINI_MODEL || "gemini-flash-latest"})` : "OFF (no GEMINI_API_KEY): using the rule-based parser"}`);
+  console.log(`  Demo time: ${demo ? `frozen at day ${demo.day}, ${demo.hour}` : "off (real Indianapolis time)"}`);
+  console.log(`  Data:      ${v.ok ? "valid" : "INVALID: " + v.errors.join("; ")}${v.warnings.length ? ` (${v.warnings.filter(w => w.includes("ESTIMATED")).length} estimated coordinates)` : ""}`);
+});
